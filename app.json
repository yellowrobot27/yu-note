{
  "expo": {
    "name": "YuNote",
    "slug": "yunote",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "yunote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#083C1D"
      },
      "package": "com.anonymous.yunote"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "YuNote",
      "shortName": "YuNote",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
